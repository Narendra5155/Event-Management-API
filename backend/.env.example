NODE_ENV=development
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/eventsphere
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12
# Login/register attempts allowed per IP every 15 minutes
AUTH_RATE_LIMIT_MAX=20
